# Frontend — contact form POST target (use proxy path in local dev)
VITE_FORM_ENDPOINT=/api/contact

# Contact API (Node server — see npm run server)
CONTACT_API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# SMTP (never commit real values; set these in .env)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, plus App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Login is usually your mailbox email (not a separate username)
SMTP_EMAIL=
SMTP_PASS=
MAIL_FROM="Zeldapro Website <noreply@yourdomain.com>"
MAIL_TO=contact@yourdomain.com